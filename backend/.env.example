# For running the backend directly on the host (uv run uvicorn / uv run pytest / alembic),
# NOT for Docker Compose - Compose passes its own DATABASE_URL as a container env var
# (see the root .env.example), which uses the "postgres" service hostname instead of localhost.
DATABASE_URL=postgresql+psycopg://fitness:fitness@localhost:5434/fitness_coach
ENVIRONMENT=development
