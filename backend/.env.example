# For running the backend directly on the host (uv run uvicorn / uv run pytest / alembic),
# NOT for Docker Compose - Compose passes its own DATABASE_URL as a container env var
# (see the root .env.example), which uses the "postgres" service hostname instead of localhost.
DATABASE_URL=postgresql+psycopg://fitness:fitness@localhost:5434/fitness_coach
ENVIRONMENT=development

# Ollama runs directly on the host here (not in Docker), so localhost is correct
# for host-based dev - the root .env.example uses host.docker.internal instead,
# since that one configures the backend running inside a container.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
