# Postgres
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness
POSTGRES_DB=fitness_coach

# Backend
DATABASE_URL=postgresql+psycopg://fitness:fitness@postgres:5432/fitness_coach
ENVIRONMENT=development

# Frontend
# Host port 8001 is used (not 8000/5432) because those are already bound by
# another local Docker/OrbStack setup on this machine - adjust if that's not your case.
VITE_API_URL=http://localhost:8001

# LLM (used from Sprint 3 onward) - local Ollama, not a hosted API key
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5
